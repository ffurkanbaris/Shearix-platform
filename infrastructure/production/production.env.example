# Copy to /etc/barber-appointment/production.env, chmod 600, and replace every
# placeholder. This file is a key inventory, not usable production config.
COMPOSE_PROJECT_NAME=barber-production
IMAGE_REGISTRY=registry.example.com/barber-appointment
RELEASE_TAG=replace-with-full-git-sha
PRODUCTION_IMAGE_LOCK_FILE=/etc/barber-appointment/releases/replace-with-full-git-sha.images.yml
SAAS_DOMAIN=shearx.app

POSTGRES_PASSWORD=replace-with-random-32-byte-secret
TENANT_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
TENANT_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
AUTH_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
AUTH_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
BARBER_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
BARBER_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
CATALOG_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
CATALOG_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
SCHEDULING_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
SCHEDULING_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
APPOINTMENT_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
APPOINTMENT_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
CUSTOMER_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
CUSTOMER_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
NOTIFICATION_DB_OWNER_PASSWORD=replace-with-random-32-byte-secret
NOTIFICATION_DB_APP_PASSWORD=replace-with-distinct-random-32-byte-secret
REDIS_PASSWORD=replace-with-random-32-byte-secret
NATS_USER=replace-with-non-default-user
NATS_PASSWORD=replace-with-random-32-byte-secret
INTERNAL_AUTH_TOKEN=replace-with-distinct-random-32-byte-secret
SERVICE_INTERNAL_TOKEN=replace-with-distinct-random-32-byte-secret
PLATFORM_ADMIN_TOKEN=replace-with-distinct-random-32-byte-secret

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
SMTP_ADDRESS=smtp.example.com:587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-secret
SMTP_IMPLICIT_TLS=false
SMTP_TIMEOUT=10s
CADDY_ACME_EMAIL=ops@example.com
GATEWAY_OUTBOUND_TIMEOUT_MS=9000

GRAFANA_ADMIN_USER=replace-with-operator-user
GRAFANA_ADMIN_PASSWORD=replace-with-random-32-byte-secret
GRAFANA_HOST_PORT=3002
ALERTMANAGER_CONFIG_FILE=/etc/barber-appointment/alertmanager.yml
PROMETHEUS_RETENTION=30d

# Preflight-only infrastructure expectations.
PRODUCTION_DOMAINS=shearx.app,platform.shearx.app
EXPECTED_PUBLIC_IP=35.198.188.47
PRODUCTION_DATA_ROOT=/var/lib/barber
MIN_FREE_DISK_GB=50

# Encrypted off-host backup repository. This prepared wrapper passes restricted
# S3-compatible credentials; extend its explicit environment allowlist before
# selecting a different restic backend.
RESTIC_REPOSITORY=s3:https://object-storage.example.com/barber-production
RESTIC_PASSWORD=replace-with-distinct-random-backup-encryption-secret
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key
RESTIC_KEEP_HOURLY=24
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
BACKUP_HEARTBEAT_URL=https://replace-with-monitoring-heartbeat.invalid
BACKUP_VERIFY_HEARTBEAT_URL=https://replace-with-separate-monitoring-heartbeat.invalid
BACKUP_STAGING_ROOT=/var/lib/barber/backup-staging
BACKUP_COMPOSE_PROJECT=barber-production
BACKUP_COMPOSE_FILES=/opt/barber-appointment/docker-compose.yml /opt/barber-appointment/infrastructure/caddy/docker-compose.production.yml /opt/barber-appointment/docker-compose.production-observability.yml
PLATFORM_ADMIN_HOST=platform.shearx.app
PLATFORM_ADMIN_EMAIL=operator@example.com
PLATFORM_ADMIN_PASSWORD_SCRYPT=replace-with-scrypt-salt:key
PLATFORM_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
