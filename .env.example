INTERNAL_AUTH_TOKEN=replace-with-a-long-development-secret
PLATFORM_ADMIN_TOKEN=replace-with-a-separate-platform-development-secret
APP_ENV=development
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_HEALTH_CHECK_PERIOD=30s
DB_CONNECT_TIMEOUT=5s
SMTP_TIMEOUT=10s
AUTH_COOKIE_NAME=barber_session
AUTH_COOKIE_SECURE=false
# Required when using infrastructure/caddy/docker-compose.production.yml.
CADDY_ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=postgres-dev-password
TENANT_DB_OWNER_PASSWORD=tenant-owner-dev-password
TENANT_DB_APP_PASSWORD=tenant-app-dev-password
AUTH_DB_OWNER_PASSWORD=auth-owner-dev-password
AUTH_DB_APP_PASSWORD=auth-app-dev-password
BARBER_DB_OWNER_PASSWORD=barber-owner-dev-password
BARBER_DB_APP_PASSWORD=barber-app-dev-password
CATALOG_DB_OWNER_PASSWORD=catalog-owner-dev-password
CATALOG_DB_APP_PASSWORD=catalog-app-dev-password
SCHEDULING_DB_OWNER_PASSWORD=scheduling-owner-dev-password
SCHEDULING_DB_APP_PASSWORD=scheduling-app-dev-password
APPOINTMENT_DB_OWNER_PASSWORD=appointment-owner-dev-password
APPOINTMENT_DB_APP_PASSWORD=appointment-app-dev-password
CUSTOMER_DB_OWNER_PASSWORD=customer-owner-dev-password
CUSTOMER_DB_APP_PASSWORD=customer-app-dev-password
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@barber.local
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=false
